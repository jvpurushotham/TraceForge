# Copy to .env (docker compose reads it automatically). Never commit .env.
# AI explanation layer is OPTIONAL. With LLM_PROVIDER=none TraceForge still diagnoses with its rule engine
# and writes a deterministic template report.
LLM_PROVIDER=none          # none | anthropic | openai   (openai = any OpenAI-compatible API, e.g. Ollama)
LLM_API_KEY=
LLM_MODEL=                 # e.g. an Anthropic model id, or "llama3.1" for Ollama
LLM_BASE_URL=              # Ollama on the host: http://host.docker.internal:11434/v1
